# Copy to .env and edit. Every setting is optional except APP_SECRET in production.

# Encrypts stored provider API keys. Use a long random value and never change it afterwards
# (changing it makes saved API keys unreadable). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-in-production

# Where the SQLite DB, vectors, uploads and model cache are stored. In Docker this is /data.
# DATA_DIR=./data

# Defaults to SQLite in DATA_DIR. The schema is Postgres-compatible, but no Postgres driver
# is bundled yet, so leave this empty unless you add one.
# DATABASE_URL=

# The first account to sign up becomes the owner. After that, sign-up is closed unless this is true.
ALLOW_SIGNUP=false

# VPS only (deploy/docker-compose.vps.yml): the domain Caddy gets an HTTPS certificate for.
# DOMAIN=rag.example.com

# The address people use to reach this server. Used in share links and the login footer.
PUBLIC_URL=http://localhost:8000

# Where the "Self-host on your server" button on public share pages points.
# PROJECT_URL=https://github.com/aiwithrc/AIwithRC-RAG

# Set to true when serving over HTTPS so the session cookie is marked Secure.
# COOKIE_SECURE=false

# Behind a reverse proxy (e.g. Caddy), set this to the proxy's IP so client IPs are logged correctly.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Model "Auto" picks the first available model matching this list (glob patterns, in order).
AUTO_MODEL_PREFERENCE=claude-sonnet*,gpt-4.1*,qwen3.5*,qwen2.5*,llama3.1*,gemma*

# Local embedding model (fastembed, CPU). Changing it later re-indexes every document.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

MAX_UPLOAD_MB=50
